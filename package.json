{
  "name": "d2r-ultimate-seed-finder-gui",
  "version": "1.3.0",
  "private": true,
  "main": "main.cjs",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "electron .",
    "patch:libd2": "node patch_libd2.mjs",
    "build:windows": "electron-builder --win portable nsis --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "libd2": "0.6.5"
  },
  "devDependencies": {
    "electron": "44.4.4",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.d2r.ultimateseedfinder",
    "productName": "D2R Ultimate Seed Finder",
    "asar": false,
    "files": [
      "main.cjs",
      "preload.cjs",
      "engine.mjs",
      "worker.mjs",
      "ui/**/*",
      "package.json",
      "node_modules/libd2/**/*",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "D2R-Ultimate-Seed-Finder-${version}-Portable.exe"
    },
    "nsis": {
      "artifactName": "D2R-Ultimate-Seed-Finder-${version}-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "D2R Ultimate Seed Finder",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "description": "Offline Diablo II: Resurrected Hell map seed finder with persistent ranking database.",
  "author": "D2R Ultimate Seed Finder Community Project",
  "license": "UNLICENSED"
}