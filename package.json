{
  "name": "d2r-ultimate-seed-finder-gui",
  "version": "1.5.2",
  "private": true,
  "main": "main.cjs",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "electron .",
    "patch:libd2": "node patch_libd2.mjs",
    "build:windows": "electron-builder --win portable --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "libd2": "0.6.5"
  },
  "devDependencies": {
    "electron": "44.4.4",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.d2r.ultimateseedfinder",
    "productName": "D2R Ultimate Seed Finder",
    "asar": false,
    "files": [
      "main.cjs",
      "preload.cjs",
      "engine.mjs",
      "worker.mjs",
      "ui/**/*",
      "package.json",
      "node_modules/libd2/**/*",
      "THIRD_PARTY_NOTICES.txt",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "D2R-Ultimate-Seed-Finder-${version}-Portable.exe"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  },
  "description": "Offline Diablo II: Resurrected Hell map seed finder with persistent ranking database, eleven route targets, and custom seed analysis.",
  "author": "Beez3-A",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beez3-A/D2R-Ultimate-Seed-Finder.git"
  },
  "bugs": {
    "url": "https://github.com/Beez3-A/D2R-Ultimate-Seed-Finder/issues"
  },
  "homepage": "https://github.com/Beez3-A/D2R-Ultimate-Seed-Finder#readme",
  "keywords": [
    "diablo-2-resurrected",
    "d2r",
    "map-seed",
    "seed-finder",
    "offline",
    "electron"
  ]
}
